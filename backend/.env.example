# DataLens Environment Configuration
APP_NAME=DataLens
APP_ENV=development
SECRET_KEY=datalens-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for instant plug & play, replace with PostgreSQL URL if desired)
DATABASE_URL=sqlite:///./data/datalens.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datalens

# File Storage
UPLOAD_DIR=./data/uploads
SAMPLE_DIR=./data/samples
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=50

# AI Provider Configuration (Optional - Defaults to Intelligent Heuristic Engine if empty)
# Providers: demo | openai | anthropic | groq | ollama
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

